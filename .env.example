# ── Server ──────────────────────────────────────────
NODE_ENV=development
PORT=5000
API_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000

# ── Database ────────────────────────────────────────
DB_PASSWORD=saloon_password
DATABASE_URL=postgresql://saloon:saloon_password@localhost:5432/saloon_db

# ── Redis ───────────────────────────────────────────
REDIS_URL=redis://localhost:6379
USE_MOCK_REDIS=true

# ── Bull Board ──────────────────────────────────────
BULL_BOARD_PORT=3001

# ── JWT ─────────────────────────────────────────────
JWT_SECRET=super_secret_jwt_key_that_is_at_least_32_characters_long
JWT_REFRESH_SECRET=super_secret_refresh_key_that_is_at_least_32_characters_long
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# ── WhatsApp (Interakt/Wati/MSG91/Mock) ─────────────
WHATSAPP_PROVIDER=mock
WHATSAPP_API_KEY=mock_key
WHATSAPP_API_URL=https://api.interakt.ai/v1

# ── OTP (OTPless or MSG91 or Mock) ─────────────────
OTP_PROVIDER=mock
OTPLESS_CLIENT_ID=mock_client_id
OTPLESS_CLIENT_SECRET=mock_client_secret

# ── Razorpay ────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_mockkeyid123
RAZORPAY_KEY_SECRET=mocksecret123
RAZORPAY_WEBHOOK_SECRET=mockwebhooksecret123

# ── IVR (Exotel or Mock) ───────────────────────────
IVR_PROVIDER=mock
EXOTEL_API_KEY=mock_exotel_key
EXOTEL_API_TOKEN=mock_exotel_token
EXOTEL_SID=mock_sid
EXOTEL_CALLER_ID=mock_caller_id

# ── File Storage (S3-compatible) ───────────────────
S3_BUCKET=saloon-uploads
S3_REGION=ap-south-1
S3_ACCESS_KEY=mock_access_key
S3_SECRET_KEY=mock_secret_key
S3_ENDPOINT=https://s3.ap-south-1.amazonaws.com
