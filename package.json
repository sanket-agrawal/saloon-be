{
  "name": "saloon-backend",
  "version": "1.0.0",
  "description": "Backend API for Saloon Booking Platform",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "worker": "tsx src/jobs/worker.ts",
    "worker:prod": "node dist/jobs/worker.js",
    "board": "tsx src/jobs/board.ts",
    "board:prod": "node dist/jobs/board.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:studio": "prisma studio",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "saloon",
    "booking",
    "fastify",
    "typescript",
    "prisma",
    "redis",
    "bullmq"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@bull-board/api": "^6.0.4",
    "@bull-board/fastify": "^6.0.4",
    "@fastify/compress": "^8.0.1",
    "@fastify/cors": "^10.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/jwt": "^9.0.4",
    "@fastify/rate-limit": "^10.2.2",
    "@prisma/client": "^6.4.1",
    "@types/ioredis-mock": "^8.2.8",
    "axios": "^1.8.1",
    "bullmq": "^5.41.6",
    "dotenv": "^16.4.7",
    "envalid": "^8.0.0",
    "fastify": "^5.2.1",
    "ioredis": "^5.5.0",
    "ioredis-mock": "^8.13.1",
    "jsonwebtoken": "^9.0.2",
    "pino": "^9.6.0",
    "qrcode": "^1.5.4",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.13.9",
    "@types/qrcode": "^1.5.5",
    "pino-pretty": "^13.0.0",
    "prisma": "^6.4.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
